          {
            "type": "expand",
            "attrs": {
              "title": "Why exponential backoff?"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A fixed delay retries in lockstep and keeps an overloaded provider down. Doubling the wait, with jitter, spreads the load:"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "attrs": {
                  "language": "ts"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "const wait = base * 2 ** attempt * (0.8 + Math.random() * 0.4);"
                  }
                ]
              }
            ]
