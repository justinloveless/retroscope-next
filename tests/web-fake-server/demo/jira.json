    {
      "key": "DEMO-123",
      "summary": "Retry failed payments with exponential backoff",
      "issueType": "Story",
      "status": "To Do",
      "statusCategory": "new",
      "priority": "High",
      "points": null,
      "parentKey": "DEMO-100",
      "sprintId": 141,
      "assignee": "demo-acc-2",
      "labels": ["payments", "reliability"],
      "description": "When the payment provider answers **503** or times out, retry the charge instead of showing an error.\n\n[[island:d3e0b1a7c0de]]\n\nAcceptance criteria:\n\n- at most 3 retries, with jitter\n- the same idempotency key on every retry\n- a declined card is **never** retried",
      "islands": {
        "d3e0b1a7c0de": {
          "t": "table",
          "c": [
            { "t": "tr", "c": [
              { "t": "th", "c": [{ "t": "p", "c": [{ "t": "text", "v": "Attempt" }] }] },
              { "t": "th", "c": [{ "t": "p", "c": [{ "t": "text", "v": "Wait" }] }] }
            ] },
            { "t": "tr", "c": [
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "1" }] }] },
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "200 ms" }] }] }
            ] },
            { "t": "tr", "c": [
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "2" }] }] },
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "800 ms" }] }] }
            ] },
            { "t": "tr", "c": [
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "3" }] }] },
              { "t": "td", "c": [{ "t": "p", "c": [{ "t": "text", "v": "3.2 s" }] }] }
            ] }
          ]
        }
      },
      "attachments": [
        { "id": "20001", "filename": "provider-error-rates.png", "mimeType": "image/png", "size": 48213 },
        { "id": "20002", "filename": "retry-sequence.png", "mimeType": "image/png", "size": 31877 }
      ],
