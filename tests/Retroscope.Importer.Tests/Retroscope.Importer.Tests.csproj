<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Retroscope.Importer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Retroscope.Importer/Retroscope.Importer.csproj" />
    <!-- Only the spot-load test (DESIGN §h.5) loads rooms through the server's stores; the alias keeps the server's
         Program and namespaces out of every other test file. -->
    <ProjectReference Include="../../src/Retroscope.Server/Retroscope.Server.csproj" Aliases="server" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
</Project>
