<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Retroscope.Server</RootNamespace>
    <AssemblyName>retroscope</AssemblyName>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Retroscope.Core/Retroscope.Core.csproj" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../db/migrations/*.sql" LinkBase="Migrations" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retroscope.Integration.Tests" />
  </ItemGroup>
</Project>
